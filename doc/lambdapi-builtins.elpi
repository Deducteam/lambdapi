

% ---- Lambdapi datatypes ----

% A symbol
data symbol.



data term.
builtin symb typ :  term = "0".
builtin symb kin :  term = "0".
builtin symb sym :  symbol -> term = "0".
builtin symb appl:  term -> term -> term = "0".
builtin symb abst:  term -> (term -> term) -> term = "0".
builtin symb prod:  term -> (term -> term) -> term = "0".
  

data sealed-goal.
builtin symb nabla : term -> (term -> sealed-goal) -> sealed-goal = "0".
builtin symb seal  : goal -> sealed-goal = "0".

data goal.
builtin symb goal  : term -> term -> goal = "0".

builtin pred msolve i:list sealed-goal.



% ---- Builtin predicates ----

% [lp.sig S T] Gives the type of a symbol
builtin func lp.sig symbol -> term.

% [lp.wrn ...] Prints a generic warning message
builtin func lp.wrn any.. .

% [lp.error ...] Prints and *aborts* the program. It is a fatal error for
% Elpi and Lambdapi
builtin func lp.error any.. .

% [lp.tc? S] Tells if S is a type class
builtin func lp.tc? symbol.

% [lp.snf X SX] SX is the snf of X
builtin func lp.snf term -> term.

% [lp.eq_modulo X Y] X = Y upto rewrite
builtin func lp.eq_modulo term, term.

% [lp.unif X Y] unify X with Y
builtin func lp.unif term, term.

% [lp.term->string T S] Pretty prints a term T to the string S
builtin func lp.term->string term -> string.

