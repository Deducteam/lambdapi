%  == Core builtins =====================================

%  -- Logic --

func true.

true.

func fail.

func false.


% [X = T] unifies X with Y, possibly assigning unification
% variables in X and Y.
builtin func (=) -> A, A.

% [pattern_matching T P] matches T against pattern P, only
% variables in P are assigned.
builtin func pattern_match A -> A.

builtin func (pi) (func A).

builtin func (sigma) (func A).

data int.


data string.


data float.


builtin pred (;) (pred), (pred).

(A ; _) :- A.

(_ ; B) :- B.

builtin symb (:-)  : (func) -> (func) -> (func) = "core".

builtin symb (:-)  : (func) -> list (pred) -> (func) = "core".

builtin symb (,)   : (func (func) ..) .

builtin symb uvar  : A = "core".

builtin symb (as)  : A -> A -> A = "core".

builtin symb (=>)  : (pred) -> (func) -> (func) = "core".

builtin symb (=>)  : list (pred) -> (func) -> (func) = "core".

builtin symb (==>) : (pred) -> (func) -> (func).

builtin symb (==>) : list (pred) -> (func) -> (func).

%  -- Control --

builtin func !. % The cut operator

func not (pred).

not X :- X, !, fail.

not _.

% [declare_constraint C Key1 Key2...] declares C blocked
% on Key1 Key2 ... (variables, or lists thereof).
builtin func declare_constraint (func) -> any .. .

% [print_constraints] prints all constraints
builtin func print_constraints.

% [halt ...] halts the program and print the terms
builtin func halt any.. .

func stop.

stop :- halt.

%  -- Evaluation --

:functional pred (is) o:A, i:A.

X is Y :- calc Y X.

% [calc Expr Out] unifies Out with the value of Expr. It can be used in
% tandem with spilling, eg [f {calc (N + 1)}]
builtin func calc A -> A.

